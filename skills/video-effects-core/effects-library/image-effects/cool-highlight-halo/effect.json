      "label": "Glow",
      "min": 0.2,
      "max": 1.5,
      "default": 0.6,
      "unit": "x",
      "animatable": true
    },
    {
      "key": "radius",
      "label": "Spread",
      "min": 1,
      "max": 6,
      "default": 2.5,
      "unit": "% of height",
      "animatable": false
    },
    {
      "key": "threshold",
      "label": "Highlight point",
      "min": 0.4,
      "max": 0.9,
      "default": 0.6,
      "unit": "0-1",
      "animatable": false
    }
  ],
  "css_filter": "url(#fx-{{iid}}-filter)",
  "needs_model": false,
  "needs_key_footage": false,
