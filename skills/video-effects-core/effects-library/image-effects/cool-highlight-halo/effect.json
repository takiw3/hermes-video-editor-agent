{
  "effect_id": "cool-highlight-halo",
  "display_name": "Cool halo",
  "family": "image-effects",
  "kind": "filter",
  "description": "A cool white-blue halo around bright edges. Clean and clinical.",
  "implementation_route": "svg-filter",
  "hyperframes_feature": null,
  "target": "wrapper",
  "applies_to": [
    "video",
    "image",
    "element"
