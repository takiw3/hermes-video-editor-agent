{
  "effect_id": "crosshatch",
  "display_name": "Crosshatch",
  "family": "image-effects",
  "kind": "media-effect",
  "description": "Pen hatching: darker areas get more crossing lines.",
  "implementation_route": "hf-media-treatment",
  "hyperframes_feature": "data-color-grading effects.crosshatch",
  "target": "media",
  "applies_to": [
    "video",
    "image"
  ],
  "parameters": [
    {
      "key": "amount",
      "label": "Amount",
      "min": 0.3,
      "max": 1,
      "default": 1,
      "unit": "0-1",
      "animatable": false
    }
  ],
  "grading": {
    "effects": {
      "crosshatch": "$p.amount",
      "crosshatchSpacing": 0.28,
      "crosshatchThickness": 0.25,
      "crosshatchAngle": 0.25,
      "crosshatchContrast": 0.333,
      "crosshatchEdges": 0.5,
      "crosshatchLineWeight": 0,
      "crosshatchWave": 0.33,
      "crosshatchWaveFrequency": 0.222
    }
  },
  "animate_vars": null,
  "needs_model": false,
  "needs_key_footage": false,
  "hdr_behavior": "SDR only. HyperFrames keeps a native HDR layer's pixels on a separate path, so the effect does not appear on it; use an SDR working copy the owner approves.",
  "deterministic": true,
  "seek_safe": true,
  "photosensitivity": "measured",
  "face_safe": true,
  "render_cost_multiplier": null,
  "provenance": "hyperframes",
  "reference_id": null,
