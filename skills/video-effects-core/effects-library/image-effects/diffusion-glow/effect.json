{
  "effect_id": "diffusion-glow",
  "display_name": "Diffusion glow",
  "family": "image-effects",
  "kind": "filter",
  "description": "A soft haze over everything, like a diffusion filter on the lens. Flattering on faces.",
  "implementation_route": "svg-filter",
  "hyperframes_feature": null,
  "target": "wrapper",
  "applies_to": [
    "video",
    "image",
    "element"
  ],
  "parameters": [
    {
      "key": "strength",
      "label": "Haze",
      "min": 0.1,
      "max": 0.8,
      "default": 0.35,
      "unit": "0-1",
      "animatable": true
    },
    {
      "key": "radius",
      "label": "Softness",
      "min": 0.5,
      "max": 4,
      "default": 1.5,
      "unit": "% of height",
      "animatable": false
    }
  ],
  "css_filter": "url(#fx-{{iid}}-filter)",
  "needs_model": false,
  "needs_key_footage": false,
  "hdr_behavior": "SDR only, like everything on the page compositor. A native HDR layer needs an SDR working copy the owner approves.",
  "deterministic": true,
  "seek_safe": true,
  "photosensitivity": "measured",
  "face_safe": true,
  "render_cost_multiplier": null,
  "provenance": "clean-room",
  "reference_id": "RS-031",
  "license": "MIT",
  "status": "implemented"
}
