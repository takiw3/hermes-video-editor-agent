{
  "effect_id": "mono-screen",
  "display_name": "Mono screen",
  "family": "image-effects",
  "kind": "media-effect",
  "description": "A single-ink screen print with a line or dot pattern.",
  "implementation_route": "hf-media-treatment",
  "hyperframes_feature": "data-color-grading effects.monoScreen",
  "target": "media",
  "applies_to": [
    "video",
    "image"
  ],
  "parameters": [
    {
      "key": "amount",
      "label": "Amount",
      "min": 0.3,
      "max": 1,
      "default": 1,
      "unit": "0-1",
      "animatable": false
    },
    {
      "key": "monoScreenSize",
      "label": "Screen size",
      "min": 0.1,
      "max": 1,
      "default": 0.35,
      "unit": "0-1",
      "animatable": false
    }
  ],
  "grading": {
    "effects": {
      "monoScreen": "$p.amount",
      "monoScreenSize": "$p.monoScreenSize",
      "monoScreenAngle": 0.25,
      "monoScreenSpread": 0.3,
      "monoScreenShape": 0,
      "monoScreenInvert": 0
    }
  },
  "animate_vars": null,
  "needs_model": false,
  "needs_key_footage": false,
  "hdr_behavior": "SDR only. HyperFrames keeps a native HDR layer's pixels on a separate path, so the effect does not appear on it; use an SDR working copy the owner approves.",
  "deterministic": true,
  "seek_safe": true,
  "photosensitivity": "measured",
  "face_safe": true,
  "render_cost_multiplier": null,
  "provenance": "hyperframes",
  "reference_id": null,
  "license": "Apache-2.0 (HyperFrames built-in, Copyright 2026 HeyGen, Inc.); this catalog entry is MIT",
  "status": "implemented"
}
