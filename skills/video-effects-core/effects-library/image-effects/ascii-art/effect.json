{
  "effect_id": "ascii-art",
  "display_name": "ASCII art",
  "family": "image-effects",
  "kind": "media-effect",
  "description": "Redraws the picture as text characters.",
  "implementation_route": "hf-media-treatment",
  "hyperframes_feature": "data-color-grading effects.ascii",
  "target": "media",
  "applies_to": [
    "video",
    "image"
  ],
  "parameters": [
    {
      "key": "amount",
      "label": "Amount",
      "min": 0.4,
      "max": 1,
      "default": 1,
      "unit": "0-1",
      "animatable": true
    },
    {
      "key": "asciiSize",
      "label": "Cell size",
      "min": 0.03,
      "max": 0.2,
      "default": 0.066,
      "unit": "0-1",
      "animatable": false
    }
  ],
  "grading": {
    "effects": {
      "ascii": "$p.amount",
      "asciiSize": "$p.asciiSize",
      "asciiInvert": 0,
      "asciiStyle": 0,
      "asciiColor": 1,
      "asciiRotation": 0
    }
  },
  "animate_vars": {
    "amount": "--hf-color-grading-ascii"
  },
  "needs_model": false,
  "needs_key_footage": false,
  "hdr_behavior": "SDR only. HyperFrames keeps a native HDR layer's pixels on a separate path, so the effect does not appear on it; use an SDR working copy the owner approves.",
  "deterministic": true,
  "seek_safe": true,
  "photosensitivity": "measured",
  "face_safe": false,
  "render_cost_multiplier": null,
  "provenance": "hyperframes",
  "reference_id": null,
  "license": "Apache-2.0 (HyperFrames built-in, Copyright 2026 HeyGen, Inc.); this catalog entry is MIT",
  "status": "implemented"
}
