{
  "effect_id": "tape-damage",
  "display_name": "Tape damage",
  "family": "image-effects",
  "kind": "media-effect",
  "description": "Tracking wobble, tearing and noise from a worn tape.",
  "implementation_route": "hf-media-treatment",
  "hyperframes_feature": "data-color-grading effects.tapeDamage",
  "target": "media",
  "applies_to": [
    "video",
    "image"
  ],
  "parameters": [
    {
      "key": "amount",
      "label": "Damage",
      "min": 0.2,
      "max": 1,
      "default": 0.65,
      "unit": "0-1",
      "animatable": false
    },
    {
      "key": "tapeTracking",
      "label": "Tracking error",
      "min": 0,
      "max": 1,
      "default": 0.55,
      "unit": "0-1",
      "animatable": false
    }
  ],
  "grading": {
    "effects": {
      "tapeDamage": "$p.amount",
      "tapeTracking": "$p.tapeTracking",
      "tapeNoise": 0.25,
      "tapeSpeed": 0.5
    }
  },
  "animate_vars": null,
  "needs_model": false,
  "needs_key_footage": false,
  "hdr_behavior": "SDR only. HyperFrames keeps a native HDR layer's pixels on a separate path, so the effect does not appear on it; use an SDR working copy the owner approves.",
  "deterministic": true,
  "seek_safe": true,
  "photosensitivity": "measured",
  "face_safe": false,
  "render_cost_multiplier": null,
  "provenance": "hyperframes",
