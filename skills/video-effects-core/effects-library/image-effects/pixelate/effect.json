{
  "effect_id": "pixelate",
  "display_name": "Pixelate",
  "family": "image-effects",
  "kind": "media-effect",
  "description": "Turns the picture into square blocks. Hides a face, a screen, or a plate on purpose.",
  "implementation_route": "hf-media-treatment",
  "hyperframes_feature": "data-color-grading effects.pixelate",
  "target": "media",
  "applies_to": [
    "video",
    "image"
  ],
  "parameters": [
    {
      "key": "amount",
      "label": "Block size",
      "min": 0.1,
      "max": 1,
      "default": 0.55,
      "unit": "0-1",
      "animatable": true
    }
  ],
  "grading": {
    "effects": {
      "pixelate": "$p.amount"
    }
  },
  "animate_vars": {
    "amount": "--hf-color-grading-pixelate"
  },
  "needs_model": false,
  "needs_key_footage": false,
  "hdr_behavior": "SDR only. HyperFrames keeps a native HDR layer's pixels on a separate path, so the effect does not appear on it; use an SDR working copy the owner approves.",
  "deterministic": true,
  "seek_safe": true,
  "photosensitivity": "measured",
  "face_safe": false,
  "render_cost_multiplier": null,
  "provenance": "hyperframes",
  "reference_id": null,
