{
  "effect_id": "posterize",
  "display_name": "Posterize",
  "family": "image-effects",
  "kind": "filter",
  "description": "Cuts each colour channel down to a few flat steps, so gradients turn into bands like a screen print.",
  "implementation_route": "svg-filter",
  "hyperframes_feature": null,
  "target": "wrapper",
  "applies_to": [
    "video",
    "image",
    "element"
  ],
  "parameters": [
    {
      "key": "levels",
      "label": "Steps per channel",
      "min": 2,
      "max": 12,
      "default": 4,
      "unit": "steps",
      "animatable": true
    }
  ],
  "css_filter": "url(#fx-{{iid}}-filter)",
  "needs_model": false,
  "needs_key_footage": false,
  "hdr_behavior": "SDR only, like everything on the page compositor. A native HDR layer needs an SDR working copy the owner approves.",
  "deterministic": true,
  "seek_safe": true,
  "photosensitivity": "measured",
  "face_safe": true,
  "render_cost_multiplier": null,
  "provenance": "clean-room",
  "reference_id": "RS-045",
  "license": "MIT",
  "status": "implemented"
}
