{
  "effect_id": "ordered-dither",
  "display_name": "Ordered dither",
  "family": "image-effects",
  "kind": "media-effect",
  "description": "A patterned dither, like an old computer screen with few colours.",
  "implementation_route": "hf-media-treatment",
  "hyperframes_feature": "data-color-grading effects.dither",
  "target": "media",
  "applies_to": [
    "video",
    "image"
  ],
  "parameters": [
    {
      "key": "amount",
      "label": "Amount",
      "min": 0.3,
      "max": 1,
      "default": 1,
      "unit": "0-1",
      "animatable": true
    },
    {
      "key": "ditherSize",
      "label": "Pattern size",
      "min": 0.1,
      "max": 1,
      "default": 0.5,
      "unit": "0-1",
      "animatable": false
    }
  ],
  "grading": {
    "effects": {
      "dither": "$p.amount",
      "ditherSize": "$p.ditherSize"
    }
  },
  "animate_vars": {
    "amount": "--hf-color-grading-dither"
  },
  "needs_model": false,
  "needs_key_footage": false,
  "hdr_behavior": "SDR only. HyperFrames keeps a native HDR layer's pixels on a separate path, so the effect does not appear on it; use an SDR working copy the owner approves.",
  "deterministic": true,
  "seek_safe": true,
  "photosensitivity": "measured",
  "face_safe": true,
  "render_cost_multiplier": null,
  "provenance": "hyperframes",
  "reference_id": null,
  "license": "Apache-2.0 (HyperFrames built-in, Copyright 2026 HeyGen, Inc.); this catalog entry is MIT",
  "status": "implemented"
}
