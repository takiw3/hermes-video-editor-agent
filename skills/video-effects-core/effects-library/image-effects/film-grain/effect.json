{
  "effect_id": "film-grain",
  "display_name": "Film grain",
  "family": "image-effects",
  "kind": "media-effect",
  "description": "Adds fine, moving film grain. Makes clean digital footage feel shot on film.",
  "implementation_route": "hf-media-treatment",
  "hyperframes_feature": "data-color-grading details.grain",
  "target": "media",
  "applies_to": [
    "video",
    "image"
  ],
  "parameters": [
    {
      "key": "amount",
      "label": "Grain",
      "min": 0.05,
      "max": 1,
      "default": 0.35,
      "unit": "0-1",
      "animatable": false
    },
    {
      "key": "grainSize",
      "label": "Grain size",
      "min": 0.05,
      "max": 1,
      "default": 0.25,
      "unit": "0-1",
      "animatable": false
    }
  ],
  "grading": {
    "details": {
      "grain": "$p.amount",
      "grainSize": "$p.grainSize"
    }
  },
  "needs_model": false,
  "needs_key_footage": false,
  "hdr_behavior": "SDR only. HyperFrames keeps a native HDR layer's pixels on a separate path, so the effect does not appear on it; use an SDR working copy the owner approves.",
  "deterministic": true,
  "seek_safe": true,
  "photosensitivity": "measured",
  "face_safe": true,
  "render_cost_multiplier": null,
  "provenance": "hyperframes",
  "reference_id": null,
