{
  "effect_id": "invert",
  "display_name": "Invert",
  "family": "image-effects",
  "kind": "filter",
  "description": "A photographic negative: every colour swapped for its opposite.",
  "implementation_route": "css-filter",
  "hyperframes_feature": null,
  "target": "wrapper",
  "applies_to": [
    "video",
    "image",
    "element"
  ],
  "parameters": [
    {
      "key": "amount",
      "label": "Amount",
      "min": 0.2,
      "max": 1,
      "default": 1,
      "unit": "0-1",
      "animatable": true
    }
  ],
  "css_filter": "invert(calc(var(--fx-{{iid}}-amount, {{p.amount}}) * var(--fx-{{iid}}-on, 1)))",
  "needs_model": false,
  "needs_key_footage": false,
  "hdr_behavior": "SDR only, like everything on the page compositor. A native HDR layer needs an SDR working copy the owner approves.",
  "deterministic": true,
  "seek_safe": true,
  "photosensitivity": "measured",
  "face_safe": true,
  "render_cost_multiplier": null,
  "provenance": "original",
  "reference_id": null,
  "license": "MIT",
  "status": "implemented"
}
