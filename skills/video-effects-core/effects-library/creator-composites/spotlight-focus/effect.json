{
  "effect_id": "spotlight-focus",
  "display_name": "Spotlight",
  "family": "creator-composites",
  "kind": "composite",
  "description": "Darkens everything except a soft circle, to point at one thing on screen.",
  "implementation_route": "gsap-composite",
  "hyperframes_feature": null,
  "target": "wrapper",
  "applies_to": [
    "video",
    "image",
    "element"
  ],
  "parameters": [
    {
      "key": "cx",
      "label": "Across",
      "min": 0.1,
      "max": 0.9,
      "default": 0.3,
      "unit": "0-1",
      "animatable": false
    },
    {
      "key": "cy",
      "label": "Down",
      "min": 0.1,
      "max": 0.9,
      "default": 0.5,
      "unit": "0-1",
      "animatable": false
    },
    {
      "key": "radius",
      "label": "Radius",
      "min": 0.1,
      "max": 0.5,
      "default": 0.25,
      "unit": "of width",
      "animatable": true
    },
    {
      "key": "dark",
      "label": "Darkness",
      "min": 0.3,
      "max": 0.9,
      "default": 0.65,
      "unit": "0-1",
      "animatable": false
    }
  ],
  "writes": [
    "transform"
  ],
  "probe": null,
  "markup_in_target": false,
  "needs_model": false,
  "needs_key_footage": false,
  "hdr_behavior": "SDR only, like everything on the page compositor. A native HDR layer needs an SDR working copy the owner approves.",
  "deterministic": true,
  "seek_safe": true,
  "photosensitivity": "measured",
  "face_safe": true,
  "render_cost_multiplier": null,
  "provenance": "original",
  "reference_id": null,
  "license": "MIT",
  "status": "implemented"
}
