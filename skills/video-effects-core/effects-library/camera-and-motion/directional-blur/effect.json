{
  "effect_id": "directional-blur",
  "display_name": "Directional blur",
  "family": "camera-and-motion",
  "kind": "filter",
  "description": "Blurs along one axis only, like motion. Sells a whip or a fast slide.",
  "implementation_route": "svg-filter",
  "hyperframes_feature": null,
  "target": "wrapper",
  "applies_to": [
    "video",
    "image",
    "element"
  ],
  "parameters": [
    {
      "key": "amount",
      "label": "Blur",
      "min": 0.3,
      "max": 5,
      "default": 1.5,
      "unit": "% of height",
      "animatable": true
    },
    {
      "key": "vertical",
      "label": "Axis (0 across, 1 up and down)",
      "min": 0,
      "max": 1,
      "default": 0,
      "unit": "choice",
      "animatable": false
    }
  ],
  "css_filter": "url(#fx-{{iid}}-filter)",
  "needs_model": false,
  "needs_key_footage": false,
  "hdr_behavior": "SDR only, like everything on the page compositor. A native HDR layer needs an SDR working copy the owner approves.",
  "deterministic": true,
  "seek_safe": true,
  "photosensitivity": "measured",
  "face_safe": true,
  "render_cost_multiplier": null,
  "provenance": "clean-room",
  "reference_id": "RS-037",
  "license": "MIT",
  "status": "implemented"
}
