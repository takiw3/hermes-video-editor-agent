    {
      "key": "zoom",
      "label": "Zoom",
      "min": 1.2,
      "max": 3,
      "default": 1.8,
      "unit": "x",
      "animatable": true
    },
    {
      "key": "time",
      "label": "Zoom time",
      "min": 0.1,
      "max": 0.6,
      "default": 0.25,
      "unit": "s",
      "animatable": false
    }
  ],
  "writes": [
    "transform"
  ],
  "needs_model": false,
  "needs_key_footage": false,
  "hdr_behavior": "SDR only, like everything on the page compositor. A native HDR layer needs an SDR working copy the owner approves.",
  "deterministic": true,
  "seek_safe": true,
  "photosensitivity": "measured",
  "face_safe": false,
  "render_cost_multiplier": null,
  "provenance": "original",
  "reference_id": null,
  "license": "MIT",
  "status": "implemented"
}
