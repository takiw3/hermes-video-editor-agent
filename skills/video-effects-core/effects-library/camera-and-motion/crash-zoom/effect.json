{
  "effect_id": "crash-zoom",
  "display_name": "Crash zoom",
  "family": "camera-and-motion",
  "kind": "camera",
  "description": "A violent, fast zoom in that lands hard. Comedy beats and reveals.",
  "implementation_route": "gsap-composite",
  "hyperframes_feature": null,
  "target": "wrapper",
  "applies_to": [
    "video",
    "image",
    "element"
  ],
