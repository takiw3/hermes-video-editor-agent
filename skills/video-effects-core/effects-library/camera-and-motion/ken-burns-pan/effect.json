{
  "effect_id": "ken-burns-pan",
  "display_name": "Ken Burns pan",
  "family": "camera-and-motion",
  "kind": "camera",
  "description": "A slow zoom-and-pan across a still or a wide shot.",
  "implementation_route": "gsap-composite",
  "hyperframes_feature": null,
  "target": "wrapper",
  "applies_to": [
    "video",
    "image",
    "element"
  ],
  "parameters": [
    {
      "key": "scale",
      "label": "Zoom",
      "min": 1.1,
      "max": 1.5,
      "default": 1.25,
      "unit": "x",
      "animatable": false
    },
    {
      "key": "pan",
      "label": "Pan across",
      "min": -1,
      "max": 1,
      "default": 0.6,
      "unit": "-1 to 1",
      "animatable": true
    },
    {
      "key": "tilt",
      "label": "Pan down",
      "min": -1,
      "max": 1,
      "default": 0,
      "unit": "-1 to 1",
      "animatable": false
    }
  ],
  "writes": [
    "transform"
  ],
  "needs_model": false,
  "needs_key_footage": false,
  "hdr_behavior": "SDR only, like everything on the page compositor. A native HDR layer needs an SDR working copy the owner approves.",
  "deterministic": true,
  "seek_safe": true,
  "photosensitivity": "measured",
  "face_safe": true,
  "render_cost_multiplier": null,
  "provenance": "original",
  "reference_id": null,
  "license": "MIT",
  "status": "implemented"
}
