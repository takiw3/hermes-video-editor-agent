{
  "effect_id": "camera-shake",
  "display_name": "Camera shake",
  "family": "camera-and-motion",
  "kind": "camera",
  "description": "Handheld impact shake. Smooth noise, not random jumps, so it reads as a camera and not a glitch.",
  "implementation_route": "gsap-composite",
  "hyperframes_feature": null,
  "target": "wrapper",
  "applies_to": [
    "video",
    "image",
    "element"
  ],
  "parameters": [
    {
      "key": "amplitude",
      "label": "Strength",
      "min": 0.2,
      "max": 4,
      "default": 1.2,
      "unit": "% of height",
      "animatable": true
    },
    {
      "key": "frequency",
      "label": "Speed",
      "min": 2,
      "max": 16,
      "default": 7,
      "unit": "Hz",
      "animatable": false
    },
    {
      "key": "rotation",
      "label": "Twist",
      "min": 0,
      "max": 3,
      "default": 0.6,
      "unit": "degrees",
      "animatable": false
    }
  ],
  "writes": [
    "transform"
  ],
  "needs_model": false,
  "needs_key_footage": false,
  "hdr_behavior": "SDR only, like everything on the page compositor. A native HDR layer needs an SDR working copy the owner approves.",
  "deterministic": true,
  "seek_safe": true,
  "photosensitivity": "measured",
  "face_safe": true,
  "render_cost_multiplier": null,
  "provenance": "original",
  "reference_id": null,
  "license": "MIT",
  "status": "implemented"
}
