{
  "effect_id": "punch-in",
  "display_name": "Punch-in",
  "family": "camera-and-motion",
  "kind": "camera",
  "description": "A quick push in on the shot, the classic jump-cut zoom for emphasis.",
  "implementation_route": "gsap-composite",
  "hyperframes_feature": null,
  "target": "wrapper",
  "applies_to": [
    "video",
    "image",
    "element"
  ],
  "parameters": [
    {
      "key": "zoom",
      "label": "Zoom",
      "min": 1.05,
      "max": 1.6,
      "default": 1.2,
      "unit": "x",
      "animatable": true
    },
    {
      "key": "ramp",
      "label": "Ramp time",
      "min": 0,
