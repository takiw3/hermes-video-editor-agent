      "label": "Key strength",
      "min": 1,
      "max": 6,
      "default": 3,
      "unit": "x",
      "animatable": true
    },
    {
      "key": "softness",
      "label": "Edge softness",
      "min": 0.05,
      "max": 1,
      "default": 0.3,
      "unit": "0-1",
      "animatable": false
    },
    {
      "key": "spill",
      "label": "Spill removal",
      "min": 0,
      "max": 1,
      "default": 0.35,
      "unit": "0-1",
      "animatable": false
