{
  "effect_id": "sun-bleached-fade",
  "display_name": "Sun-bleached fade",
  "family": "looks-and-grades",
  "kind": "look",
  "description": "Warm and washed out, like a photo left in the sun.",
  "implementation_route": "hf-color-grade",
  "hyperframes_feature": "data-color-grading (this profile's values)",
  "target": "media",
  "applies_to": [
    "video",
    "image"
  ],
  "parameters": [
    {
      "key": "intensity",
      "label": "Strength",
      "min": 0.25,
      "max": 1,
      "default": 0.85,
      "unit": "0-1",
      "animatable": true
    }
  ],
  "grading": {
    "adjust": {
      "saturation": -0.28,
      "temperature": 0.22,
      "contrast": -0.1
    },
    "curves": {
      "master": [
        [
          0,
          0.1
        ],
        [
          1,
          0.9
        ]
      ]
    },
    "intensity": "$p.intensity"
  },
  "animate_vars": {
    "intensity": "--hf-color-grading-intensity"
  },
  "needs_model": false,
  "needs_key_footage": false,
  "hdr_behavior": "SDR only. HyperFrames keeps a native HDR layer's pixels on a separate path, so the effect does not appear on it; use an SDR working copy the owner approves.",
  "deterministic": true,
  "seek_safe": true,
  "photosensitivity": "measured",
  "face_safe": true,
  "render_cost_multiplier": null,
  "provenance": "clean-room",
  "reference_id": "RS-084",
  "license": "MIT",
  "status": "implemented"
}
