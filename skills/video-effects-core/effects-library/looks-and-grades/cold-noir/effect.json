{
  "effect_id": "cold-noir",
  "display_name": "Cold noir",
  "family": "looks-and-grades",
  "kind": "look",
  "description": "Black and white with a faint blue cast and dark edges.",
  "implementation_route": "hf-color-grade",
  "hyperframes_feature": "data-color-grading (this profile's values)",
  "target": "media",
  "applies_to": [
    "video",
    "image"
  ],
  "parameters": [
    {
      "key": "intensity",
      "label": "Strength",
      "min": 0.25,
      "max": 1,
      "default": 0.85,
      "unit": "0-1",
      "animatable": true
    }
  ],
  "grading": {
    "adjust": {
      "saturation": -1,
      "contrast": 0.3,
      "blacks": -0.08
    },
    "wheels": {
      "shadows": {
        "hue": 215,
        "amount": 0.22,
        "level": 0
      },
      "midtones": {
        "hue": 210,
        "amount": 0.08,
        "level": 0
      }
    },
    "details": {
      "vignette": 0.4
    },
    "intensity": "$p.intensity"
  },
  "animate_vars": {
    "intensity": "--hf-color-grading-intensity"
  },
  "needs_model": false,
  "needs_key_footage": false,
  "hdr_behavior": "SDR only. HyperFrames keeps a native HDR layer's pixels on a separate path, so the effect does not appear on it; use an SDR working copy the owner approves.",
  "deterministic": true,
  "seek_safe": true,
  "photosensitivity": "measured",
  "face_safe": true,
  "render_cost_multiplier": null,
  "provenance": "clean-room",
  "reference_id": "RS-079",
  "license": "MIT",
  "status": "implemented"
}
