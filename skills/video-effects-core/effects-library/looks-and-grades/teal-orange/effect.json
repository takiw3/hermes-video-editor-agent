{
  "effect_id": "teal-orange",
  "display_name": "Teal and orange",
  "family": "looks-and-grades",
  "kind": "look",
  "description": "Pushes shadows toward teal and highlights toward orange, so skin stands out from the background.",
  "implementation_route": "hf-color-grade",
  "hyperframes_feature": "data-color-grading (this profile's values)",
  "target": "media",
  "applies_to": [
    "video",
    "image"
  ],
  "parameters": [
    {
      "key": "intensity",
      "label": "Strength",
      "min": 0.25,
      "max": 1,
      "default": 0.85,
      "unit": "0-1",
      "animatable": true
    }
  ],
  "grading": {
    "adjust": {
      "contrast": 0.12,
      "vibrance": 0.1
    },
    "wheels": {
      "shadows": {
        "hue": 190,
        "amount": 0.32,
        "level": -0.02
      },
      "highlights": {
        "hue": 32,
        "amount": 0.26,
        "level": 0.02
      }
    },
    "intensity": "$p.intensity"
  },
  "animate_vars": {
    "intensity": "--hf-color-grading-intensity"
  },
  "needs_model": false,
  "needs_key_footage": false,
  "hdr_behavior": "SDR only. HyperFrames keeps a native HDR layer's pixels on a separate path, so the effect does not appear on it; use an SDR working copy the owner approves.",
  "deterministic": true,
  "seek_safe": true,
  "photosensitivity": "measured",
  "face_safe": true,
  "render_cost_multiplier": null,
  "provenance": "clean-room",
  "reference_id": "RS-093",
  "license": "MIT",
  "status": "implemented"
}
