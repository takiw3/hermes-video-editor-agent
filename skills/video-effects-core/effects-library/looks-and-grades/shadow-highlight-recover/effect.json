{
  "effect_id": "shadow-highlight-recover",
  "display_name": "Shadow and highlight recovery",
  "family": "looks-and-grades",
  "kind": "correction",
  "description": "Opens up dark areas and brings back bright ones in one move. For backlit faces and bright windows.",
  "implementation_route": "hf-color-grade",
  "hyperframes_feature": "data-color-grading adjust.shadows and adjust.highlights",
  "target": "media",
  "applies_to": [
    "video",
    "image"
  ],
  "parameters": [
    {
      "key": "amount",
      "label": "Recovery",
      "min": 0.1,
      "max": 1,
      "default": 0.5,
      "unit": "0-1",
      "animatable": false
    }
  ],
  "grading": {
    "adjust": {
      "shadows": "$p.amount",
      "highlights": "$-p.amount"
    }
  },
  "needs_model": false,
  "needs_key_footage": false,
  "hdr_behavior": "SDR only. HyperFrames keeps a native HDR layer's pixels on a separate path, so the effect does not appear on it; use an SDR working copy the owner approves.",
  "deterministic": true,
  "seek_safe": true,
  "photosensitivity": "measured",
  "face_safe": true,
  "render_cost_multiplier": null,
  "provenance": "original",
  "reference_id": null,
  "license": "MIT",
  "status": "implemented"
}
