{
  "effect_id": "exposure-stops",
  "display_name": "Exposure",
  "family": "looks-and-grades",
  "kind": "correction",
  "description": "Brightens or darkens the whole picture, like opening or closing the lens.",
  "implementation_route": "hf-color-grade",
  "hyperframes_feature": "data-color-grading adjust.exposure",
  "target": "media",
  "applies_to": [
    "video",
    "image"
  ],
  "parameters": [
    {
      "key": "amount",
      "label": "Exposure",
      "min": -1.5,
      "max": 1.5,
      "default": 0.5,
      "unit": "stops-ish",
      "animatable": true
    }
  ],
  "grading": {
    "adjust": {
      "exposure": "$p.amount"
    }
  },
  "animate_vars": {
    "amount": "--hf-color-grading-exposure"
