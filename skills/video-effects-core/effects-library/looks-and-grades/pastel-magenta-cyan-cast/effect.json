{
  "effect_id": "pastel-magenta-cyan-cast",
  "display_name": "Pastel magenta and cyan",
  "family": "looks-and-grades",
  "kind": "look",
  "description": "Soft pastels: pink highlights, cyan shadows, lifted blacks.",
  "implementation_route": "hf-color-grade",
  "hyperframes_feature": "data-color-grading (this profile's values)",
  "target": "media",
  "applies_to": [
    "video",
    "image"
  ],
  "parameters": [
    {
      "key": "intensity",
      "label": "Strength",
      "min": 0.25,
      "max": 1,
      "default": 0.85,
      "unit": "0-1",
      "animatable": true
    }
  ],
  "grading": {
    "adjust": {
      "saturation": -0.12
    },
    "wheels": {
      "shadows": {
        "hue": 180,
        "amount": 0.26,
        "level": 0.02
      },
      "highlights": {
        "hue": 302,
        "amount": 0.26,
        "level": 0
      }
    },
    "curves": {
      "master": [
        [
          0,
          0.08
        ],
        [
          1,
          0.97
        ]
      ]
    },
    "intensity": "$p.intensity"
  },
  "animate_vars": {
    "intensity": "--hf-color-grading-intensity"
  },
  "needs_model": false,
  "needs_key_footage": false,
  "hdr_behavior": "SDR only. HyperFrames keeps a native HDR layer's pixels on a separate path, so the effect does not appear on it; use an SDR working copy the owner approves.",
  "deterministic": true,
  "seek_safe": true,
  "photosensitivity": "measured",
  "face_safe": true,
  "render_cost_multiplier": null,
  "provenance": "clean-room",
  "reference_id": "RS-097",
  "license": "MIT",
  "status": "implemented"
}
