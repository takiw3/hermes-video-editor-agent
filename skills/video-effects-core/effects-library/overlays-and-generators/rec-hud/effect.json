{
  "effect_id": "rec-hud",
  "display_name": "Camcorder HUD",
  "family": "overlays-and-generators",
  "kind": "overlay",
  "description": "REC dot, running timecode and corner marks, like a camcorder viewfinder. The dot blinks once a second.",
  "implementation_route": "gsap-composite",
  "hyperframes_feature": null,
  "target": "overlay",
  "applies_to": [
    "composition"
  ],
  "parameters": [
    {
      "key": "opacity",
      "label": "Opacity",
      "min": 0.4,
      "max": 1,
      "default": 0.9,
      "unit": "0-1",
      "animatable": true
    },
    {
      "key": "offset",
      "label": "Timecode start",
      "min": 0,
      "max": 3600,
      "default": 0,
      "unit": "s",
      "animatable": false
    }
  ],
  "needs_model": false,
  "needs_key_footage": false,
  "hdr_behavior": "SDR only, like everything on the page compositor. A native HDR layer needs an SDR working copy the owner approves.",
  "deterministic": true,
  "seek_safe": true,
  "photosensitivity": "measured",
  "face_safe": true,
  "render_cost_multiplier": null,
  "provenance": "original",
  "reference_id": null,
  "license": "MIT",
  "status": "implemented"
}
