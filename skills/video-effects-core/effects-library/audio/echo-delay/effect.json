{
  "effect_id": "echo-delay",
  "display_name": "Echo",
  "family": "audio",
  "kind": "audio",
  "description": "Repeats of the sound that fade away.",
  "implementation_route": "hf-audio-fx",
  "hyperframes_feature": "data-fx-chain delay",
  "target": "audio",
  "applies_to": [
    "audio",
    "video"
  ],
  "parameters": [
    {
      "key": "time",
      "label": "Delay",
      "min": 50,
      "max": 600,
      "default": 250,
      "unit": "ms",
      "animatable": false
    },
    {
      "key": "feedback",
      "label": "Repeats",
      "min": 0.1,
      "max": 0.8,
      "default": 0.35,
      "unit": "0-1",
      "animatable": false
    },
    {
      "key": "mix",
      "label": "Mix",
      "min": 0.2,
      "max": 1,
      "default": 0.5,
      "unit": "0-1",
      "animatable": false
    }
  ],
  "fx_chain": [
    {
      "type": "delay",
      "id": "n1",
      "params": {
        "time": "$p.time",
        "feedback": "$p.feedback",
        "mix": "$p.mix"
      }
    }
  ],
  "measure": null,
  "needs_model": false,
  "needs_key_footage": false,
  "hdr_behavior": "Not applicable: audio.",
  "deterministic": true,
  "seek_safe": true,
  "photosensitivity": "measured",
  "face_safe": true,
  "render_cost_multiplier": null,
  "provenance": "hyperframes",
  "reference_id": null,
