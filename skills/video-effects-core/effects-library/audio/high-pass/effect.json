{
  "effect_id": "high-pass",
  "display_name": "High-pass filter",
  "family": "audio",
  "kind": "audio",
  "description": "Cuts rumble and hum below a frequency. The first fix on most voice tracks.",
  "implementation_route": "hf-audio-fx",
  "hyperframes_feature": "data-fx-chain highpass",
  "target": "audio",
  "applies_to": [
    "audio",
    "video"
  ],
  "parameters": [
    {
      "key": "frequency",
      "label": "Cut below",
      "min": 100,
      "max": 1000,
      "default": 300,
      "unit": "Hz",
      "animatable": false
    }
  ],
  "fx_chain": [
    {
      "type": "highpass",
      "id": "n1",
      "params": {
        "frequency": "$p.frequency",
        "q": 0.707,
        "poles": 2
      }
    }
  ],
  "measure": {
    "hz": 60,
    "below": 0.5
  },
